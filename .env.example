# Copy to .env and fill in. Never commit .env.

# --- Public endpoint (Caddy issues the TLS certificate automatically) ---
DOMAIN=bridge.duckcrm.one

# --- Datastores (docker-compose builds DATABASE_URL / REDIS_URL from these) ---
POSTGRES_USER=pinbridge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pinbridge
REDIS_PASSWORD=change-me

# For running outside docker compose (local development):
# DATABASE_URL=postgresql://pinbridge:change-me@localhost:5432/pinbridge
# REDIS_URL=redis://:change-me@localhost:6379

# --- App ---
NODE_ENV=production
LOG_LEVEL=info

# --- Secrets (generate each with: openssl rand -base64 32) ---
# Encrypts Pin tokens, device keys and signing secrets in the database. Losing it makes them
# unreadable; leaking it together with a DB dump exposes them. Store it outside the server too.
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=k1
# Rotation: set a new ENCRYPTION_KEY/ENCRYPTION_KEY_ID and keep the old one here as id:key.
# ENCRYPTION_PREVIOUS_KEYS=k1:<old base64 key>
# Mixed into API key hashes. Changing it invalidates every issued API key.
API_KEY_PEPPER=

# --- Agency API ---
# SIGNATURE_TOLERANCE_SECONDS=300
# API_IP_RATE_LIMIT_RPS=50
# API_RATE_LIMIT_RPS=20
# ENROLL_IP_RATE_LIMIT_PER_MIN=5
# Self-service enrollment by the CRM platform (POST /v1/platform/agencies). Unset = disabled.
# The same secret goes into every CRM deployment (openssl rand -hex 32).
# PLATFORM_SIGNING_SECRET=
# PLATFORM_AGENCY_ORIGIN=https://{slug}.duckcrm.one
# PLATFORM_VERIFY_TIMEOUT_MS=5000
# API_RATE_LIMIT_BURST=40

# --- Metrics ---
# Required in production. Bearer token for /metrics; put the same value in
# docker/monitoring/metrics_token (openssl rand -hex 24).
METRICS_TOKEN=

# --- Fairness between agencies ---
# AGENCY_SYNC_CONCURRENCY=2
# AGENCY_PIN_RPS=1
# CONNECTION_MAX_WRONG_CODES_PER_DAY=10

# --- Publishing ---
# LISTING_SYNC_CONCURRENCY=4
# LISTING_SYNC_ATTEMPTS=8
# LISTING_SYNC_BACKOFF_MS=30000
# IMAGE_FETCH_TIMEOUT_MS=15000
# IMAGE_MAX_BYTES=15728640
# Never enable in production: disables SSRF protection for photo and webhook URLs.
# UNSAFE_ALLOW_PRIVATE_OUTBOUND_HOSTS=false

# --- Webhooks and status tracking ---
# WEBHOOK_DISPATCH_INTERVAL_MS=3000
# WEBHOOK_TIMEOUT_MS=10000
# WEBHOOK_RETRY_BASE_MS=10000
# WEBHOOK_MAX_AGE_MS=86400000
# STATUS_SYNC_INTERVAL_MS=60000
# STATUS_SYNC_CONNECTIONS_PER_TICK=20

# --- Pin ---
PIN_BASE_URL=https://pin.tt
# Set only if Pin traffic must go through a forward proxy holding the allowlisted IP.
# PIN_HTTPS_PROXY=http://egress-proxy:3128

# Timeouts (ms)
# PIN_CONNECT_TIMEOUT_MS=5000
# PIN_REQUEST_TIMEOUT_MS=30000
# PIN_UPLOAD_TIMEOUT_MS=60000

# Global outgoing budget to Pin, shared by all processes via Redis.
# Raise only after Pin confirms what their prod tolerates.
# PIN_RATE_LIMIT_RPS=5
# PIN_RATE_LIMIT_BURST=10
# PIN_RATE_LIMIT_MAX_WAIT_MS=10000

# Circuit breaker: pause calls when >= ratio of at least MIN_REQUESTS calls fail within WINDOW.
# PIN_BREAKER_WINDOW_MS=60000
# PIN_BREAKER_MIN_REQUESTS=20
# PIN_BREAKER_FAILURE_RATIO=0.5
# PIN_BREAKER_OPEN_MS=30000
