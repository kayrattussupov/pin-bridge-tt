{
  "name": "pin-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Integration server between real estate agencies and the pin.tt API",
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node dist/main.api.js",
    "start:worker": "node dist/main.worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "fake-pin": "tsx test/fake-pin/main.ts",
    "pin:smoke": "node dist/cli/pin-smoke.js",
    "admin": "node dist/cli/admin.js",
    "loadtest": "tsx scripts/loadtest.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/terminus": "^12.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bullmq": "^6.3.11",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fastify/multipart": "^10.1.2",
    "@swc/core": "^1.16.13",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "autocannon": "^8.0.0",
    "eslint": "^10.12.0",
    "fastify": "^5.12.5",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
