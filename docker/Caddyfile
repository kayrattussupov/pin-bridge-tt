{
	servers {
		protocols h1 h2 h3
	}
}

{$DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 1MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Readiness and metrics expose infrastructure details; only liveness is public.
	@private path /health/ready /metrics /metrics/*
	respond @private 404

	reverse_proxy api:3000 {
		health_uri /health/live
		health_interval 10s
		transport http {
			dial_timeout 3s
			response_header_timeout 30s
		}
	}

	log {
		output stdout
		format json
	}
}
